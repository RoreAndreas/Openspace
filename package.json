    "react-dom": "^19.3.0",
    "zustand": "^5.0.15",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.152.0"
  }
}

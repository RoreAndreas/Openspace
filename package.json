{
  "name": "openspace",
  "version": "0.1.0",
  "private": true,
  "description": "L'open space : une équipe d'agents IA (Lilou, la cheffe, et un analyste) qui travaille sous tes yeux dans un bureau en pixel art, pour une responsable marketing et communication. Hébergé sur Cloudflare (Workers AI). D'après « Le Bureau des agents » de VibesMoney (MIT).",
  "license": "MIT",
  "author": "RoreAndreas, d’après VibesMoney (https://vibesmoney.com)",
  "homepage": "https://github.com/RoreAndreas/openspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoreAndreas/openspace.git"
  },
  "bugs": {
    "url": "https://github.com/RoreAndreas/openspace/issues"
  },
  "keywords": [
    "agents",
    "ai-agents",
    "pixel-art",
    "cloudflare",
    "workers-ai",
    "marketing"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
